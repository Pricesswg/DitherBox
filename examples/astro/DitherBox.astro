---
/**
 * Componente Astro pronto da incollare in src/components/.
 *
 * Uso:
 *   ---
 *   import DitherBox from '../components/DitherBox.astro';
 *   ---
 *   <DitherBox palette="gameboy" algorithm="bayer4" scale={4} />
 *   <DitherBox palette="#0a0c10,#c2fe0b" megapixels={0.3} />
 *   <DitherBox theme="dark" />
 *
 * Lo script sta in un blocco <script> normale: Astro lo impacchetta e lo
 * manda solo al browser, quindi il widget non viene mai eseguito sul server.
 * I parametri passano dal frontmatter al client via attributi data-*, che e'
 * esattamente quello che autoInit() si aspetta di trovare.
 */
export interface Props {
  /** Nome di una tavolozza ("gameboy", "marathon") oppure un elenco di
   *  colori scritto a mano: "#0a0c10,#c2fe0b". */
  palette?: string;
  algorithm?: string;
  scale?: number;
  strength?: number;
  bias?: number;
  noise?: number;
  brightness?: number;
  contrast?: number;
  gamma?: number;
  saturation?: number;
  sharpen?: number;
  invert?: boolean;
  serpentine?: boolean;
  megapixels?: number;
  upscale?: boolean;
  /** Immagine da caricare all'avvio, invece della schermata vuota. */
  src?: string;
  /**
   * Impone lo schema di colore invece di seguire le preferenze del sistema.
   * Su un sito che e' solo scuro va messo "dark", se no il widget si
   * ribalta in chiaro addosso a chi tiene il sistema in chiaro.
   */
  theme?: 'dark' | 'light';
  class?: string;
}

const { class: className, src, theme, ...options } = Astro.props;

// Solo i parametri davvero passati diventano attributi: gli altri
// restano ai valori di partenza del widget.
const dataset = Object.fromEntries(
  Object.entries(options)
    .filter(([, value]) => value !== undefined)
    .map(([key, value]) => [`data-${key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`, String(value)]),
);
---

<div class={className} data-ditherbox data-src={src} data-theme={theme} {...dataset}></div>

<script>
  import { autoInit } from 'ditherbox/web';
  import 'ditherbox/web/style.css';

  // autoInit salta gli elementi gia' agganciati, quindi e' sicuro
  // richiamarlo anche dopo una navigazione con le view transition.
  autoInit();
  document.addEventListener('astro:page-load', () => autoInit());
</script>
