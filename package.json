{
  "name": "ditherbox",
  "version": "0.1.0",
  "description": "Adjustable dithering for photos: a terminal app plus a drop-in web widget, with palettes from the Game Boy to the Mega Drive",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Simonitto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pricesswg/DitherBox.git"
  },
  "bugs": {
    "url": "https://github.com/Pricesswg/DitherBox/issues"
  },
  "homepage": "https://github.com/Pricesswg/DitherBox#readme",
  "keywords": [
    "16-bit",
    "8-bit",
    "ascii-art",
    "astro",
    "atkinson",
    "bayer",
    "braille",
    "dithering",
    "floyd-steinberg",
    "i18n",
    "marathon",
    "nes",
    "palette",
    "pixel-art",
    "retro",
    "tui"
  ],
  "bin": {
    "ditherbox": "bin/ditherbox.js"
  },
  "main": "./src/core/index.js",
  "exports": {
    ".": "./src/core/index.js",
    "./core": "./src/core/index.js",
    "./web": "./src/web/ditherbox.js",
    "./web/style.css": "./src/web/ditherbox.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "demo": "node bin/ditherbox.js",
    "screenshot": "node scripts/screenshot.js",
    "termshot": "node scripts/termshot.js",
    "docs": "node scripts/docs-images.js",
    "presets": "node scripts/contact-sheet.js"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
