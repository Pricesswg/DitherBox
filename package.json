{
  "name": "ditherbox",
  "version": "0.1.0",
  "description": "Dithering regolabile per foto: widget da mettere nel sito piu' app da terminale con interfaccia in stile cliamp",
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Simonitto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pricesswg/DitherBox.git"
  },
  "bugs": {
    "url": "https://github.com/Pricesswg/DitherBox/issues"
  },
  "homepage": "https://github.com/Pricesswg/DitherBox#readme",
  "keywords": [
    "dithering",
    "bayer",
    "floyd-steinberg",
    "atkinson",
    "pixel-art",
    "tui",
    "astro",
    "marathon",
    "palette"
  ],
  "bin": {
    "ditherbox": "bin/ditherbox.js"
  },
  "main": "./src/core/index.js",
  "exports": {
    ".": "./src/core/index.js",
    "./core": "./src/core/index.js",
    "./web": "./src/web/ditherbox.js",
    "./web/style.css": "./src/web/ditherbox.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "demo": "node bin/ditherbox.js",
    "screenshot": "node scripts/screenshot.js"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
